# BioNaut Environment Variables
# Copy this file to .env and fill in your values for local development
# For deployment (Vercel, Netlify, etc.), set these in your platform's environment settings

# Backend API URL (optional - app works in fallback mode if not set)
VITE_API_URL=https://your-backend-api-url.com

# Google Gemini AI API Key (required for AI features)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# External Summarizer API (pre-configured, no change needed)
VITE_SUMMARIZER_API_URL=https://summarizer-model.onrender.com
